{
  "buildCommand": "npm run validate && npm run build",
  "framework": "nextjs",
  "regions": ["nrt1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "rewrites": [],
  "env": {
    "NODE_ENV": "production"
  }
}
